#!/usr/bin/env -S uvx --from=rust-just just --justfile

just := "just --justfile " + justfile()

replay_file := "resources/replay-example-cli.json"
render_dir := "annex/update/example-cli"
work_dir := "annex/update/example-cli-copy"
diff_target_dir := "annex/update/example-cli-diff"
recipe_dir := "{{ cookiecutter.package_name }}"

@default:
  {{ just }} --list

# Render the current recipe and create a working copy for edits.
refresh-render-and-copy replay=replay_file render=render_dir work=work_dir:
  #!/usr/bin/env bash
  set -euo pipefail

  DEBUG=${DEBUG:-}
  if [[ ! -z $DEBUG ]]; then
    PS4='+($(basename ${BASH_SOURCE}):${LINENO}): ${FUNCNAME[0]:+${FUNCNAME[0]}(): }'
    set -x
  fi

  ROOT_DIR="$(cd "$(dirname '{{ justfile() }}')" && pwd)"
  REPLAY_FILE="$ROOT_DIR/{{ replay }}"
  RENDER_DIR="$ROOT_DIR/{{ render }}"
  WORK_DIR="$ROOT_DIR/{{ work }}"
  OUTPUT_PARENT="$(dirname "$RENDER_DIR")"

  export XDG_CACHE_HOME="${XDG_CACHE_HOME:-/tmp/cookiecutter-ducted-cli-xdg-cache}"
  export XDG_DATA_HOME="${XDG_DATA_HOME:-/tmp/cookiecutter-ducted-cli-xdg-data}"
  export UV_CACHE_DIR="${UV_CACHE_DIR:-/tmp/cookiecutter-ducted-cli-uv-cache}"

  rm -rf "$RENDER_DIR" "$WORK_DIR"
  uvx cookiecutter "$ROOT_DIR" --replay-file "$REPLAY_FILE" -o "$OUTPUT_PARENT"
  cp -a "$RENDER_DIR" "$WORK_DIR"
  cd "$WORK_DIR" && git init

  printf 'Rendered recipe to %s\n' "$RENDER_DIR"
  printf 'Created working copy at %s and initialized git\n' "$WORK_DIR"

